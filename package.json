{
  "name": "quizapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:types": "openapi-typescript http://localhost:3000/api/docs-json -o ./src/features/quiz/api-types.ts",
    "shared:build": "npm run build -w shared",
    "backend:dev": "npm run start:dev -w backend"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@quizapp/shared": "*",
    "clsx": "^2.1.1",
    "pixi-spine": "^3.1.2",
    "pixi.js": "^6.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}